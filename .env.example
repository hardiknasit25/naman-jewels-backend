# Copy to .env and adjust for your environment.
PORT=3000
NODE_ENV=development

# CORS: origins allowed to call this API (the frontend app runs separately).
# "*" allows any origin; or a comma-separated list of exact origins, e.g.
# http://localhost:5173,https://admin.namanjewels.com
CORS_ORIGIN=*

# JWT
JWT_SECRET=change-me
# Default session length for the seeded admin (drives JWT expiry).
# One of: 2h | 4h | 12h | 1d | 1w | 1m
ADMIN_SESSION_DURATION=1d

# Public origin this API is served from, e.g. https://naman.kriviinfo.com
# Used only by the /p/:sku product share page (the link the app puts in a
# WhatsApp inquiry), to build the absolute og:image URL its preview card needs.
# Optional — leave unset to derive it from the incoming request, which is correct
# as long as your proxy forwards Host and X-Forwarded-Proto.
PUBLIC_BASE_URL=

# Uploaded images. Relative paths resolve against the process working directory,
# which is not guaranteed under IIS/iisnode — set an ABSOLUTE path in production.
# Must live outside dist/ so a redeploy never overwrites or deletes it, and it
# needs to be in your backup routine: the database no longer holds the images.
UPLOAD_DIR=uploads

# MySQL / Sequelize
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naman_jewels
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
